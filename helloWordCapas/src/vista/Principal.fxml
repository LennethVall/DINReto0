<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.PrincipalController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 10;">
         <children>
            <Label fx:id="lblBienvenida" text="Bienvenido/a, " />
            <Label fx:id="lblRol" text="Rol: -" />
            <Button onAction="#handleCerrarSesion" text="Cerrar Sesión" />
         </children>
      </HBox>
   </top>

   <left>
      <VBox spacing="10.0" style="-fx-padding: 10;" BorderPane.alignment="CENTER">
         <children>
            <Button maxWidth="Infinity" onAction="#mostrarDatosPersonales" text="Datos Personales" />
            <Button maxWidth="Infinity" onAction="#mostrarHorario" text="Horario" />
            <Button fx:id="btnEncargado" maxWidth="Infinity" onAction="#mostrarEncargado" text="Encargado" />
            <Button fx:id="btnSubordinados" maxWidth="Infinity" onAction="#mostrarSubordinados" text="Subordinados" />
         </children>
      </VBox>
   </left>

   <center>
      <VBox spacing="10.0" style="-fx-padding: 10;" BorderPane.alignment="CENTER">
         <children>
            
            <!-- DATOS PERSONALES -->
            <VBox fx:id="panelDatosPersonales" spacing="10.0" visible="false">
               <children>
                  <Label text="DATOS PERSONALES" />
                  <GridPane hgap="10.0" vgap="5.0">
                     <children>
                        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtNombre" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        
                        <Label text="Apellido:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtApellido" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label text="DNI:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="txtDni" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        
                        <Label text="Puesto:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextField fx:id="txtPuesto" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        
                        <Label text="ID Empleado:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <TextField fx:id="txtIdEmpl" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        
                        <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <TextField fx:id="txtDireccion" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                        
                        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                        <TextField fx:id="txtTelefono" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                        
                        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                        <TextField fx:id="txtEmail" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                     </children>
                  </GridPane>
                  <HBox spacing="10.0">
                     <children>
                        <Button fx:id="btnModificarDatos" onAction="#habilitarEdicionDatos" text="Modificar" />
                        <Button fx:id="btnAceptarDatos" disable="true" onAction="#guardarDatosPersonales" text="Aceptar Cambios" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- ENCARGADO / SUPERIOR -->
            <VBox fx:id="panelEncargado" spacing="10.0" visible="false">
               <children>
                  <Label text="SUPERIOR DIRECTO" />
                  <Label fx:id="lblDatosEncargado" text="Sin superior asignado." />
               </children>
            </VBox>

            <!-- SUBORDINADOS -->
            <VBox fx:id="panelSubordinados" spacing="10.0" visible="false">
               <children>
                  <Label text="EMPLEADOS SUBORDINADOS" />
                  <ListView fx:id="listSubordinados" prefHeight="150.0" />
                  <HBox spacing="10.0">
                     <children>
                        <Button onAction="#consultarDatosSubordinado" text="Consultar Datos" />
                        <Button onAction="#consultarHorarioSubordinado" text="Consultar/Editar Horario" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- HORARIO -->
            <VBox fx:id="panelHorario" spacing="10.0" visible="false">
               <children>
                  <Label text="CALENDARIO DE HORARIOS" />
                  <Label text="(Panel para cuadrante mensual)" />
               </children>
            </VBox>

         </children>
      </VBox>
   </center>
</BorderPane>